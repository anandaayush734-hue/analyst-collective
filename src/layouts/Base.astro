---
import '../styles/global.css';
import Ticker from '../components/Ticker.astro';
import { latest, fmtDate, sectors } from '../lib';
interface Props { title?: string; description?: string }
const { title, description = 'Daily intelligence on EV, Automobiles, General Industrials and Aerospace & Defence, written for senior bankers.' } = Astro.props;
const fullTitle = title ? `${title} | The Analyst Collective` : 'The Analyst Collective';
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Today' },
  ...sectors.map((s) => ({ href: `/sectors/${s.slug}/`, label: s.short })),
  { href: '/deals/', label: 'Deal Tracker' },
  { href: '/case-studies/', label: 'Case Studies' },
  { href: '/glossary/', label: 'Glossary' },
  { href: '/briefs/', label: 'Archive' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;700&family=Inter:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&display=swap" rel="stylesheet" />
  <script is:inline>
    /* Apply the reader's saved theme before the page paints (no flash). */
    try { var t = localStorage.getItem('tac-theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
</head>
<body>
  {latest && <Ticker items={latest.ticker} date={fmtDate(latest.date, { day: '2-digit', month: 'short', year: 'numeric' })} />}
  <header class="masthead">
    <div class="wrap">
      <div class="mast-top">
        <span class="muted small">{latest ? fmtDate(latest.date) : ''}</span>
        <span class="mast-right">
          <span class="muted small hide-sm">Industrials Coverage · India &amp; Global</span>
          <span class="theme-switch" role="group" aria-label="Colour mode">
            <button type="button" data-set="light" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M4.6 19.4l2.1-2.1M17.3 6.7l2.1-2.1"/></svg>Light</button>
            <button type="button" data-set="dark" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11z"/></svg>Dark</button>
          </span>
        </span>
      </div>
      <a href="/" class="logo">The Analyst Collective</a>
      <p class="tagline">EV · Automobiles · General Industrials · Aerospace &amp; Defence</p>
    </div>
    <nav class="nav" aria-label="Main">
      <div class="wrap nav-inner">
        {nav.map((n) => (
          <a href={n.href} class={(n.href === '/' ? path === '/' : path.startsWith(n.href)) ? 'on' : ''}>{n.label}</a>
        ))}
      </div>
    </nav>
  </header>
  <main class="wrap"><slot /></main>
  <footer class="foot">
    <div class="wrap">
      <p class="logo-sm">The Analyst Collective</p>
      <p class="muted small"><strong>Disclaimer.</strong> Content is compiled solely from publicly available sources, which are cited and linked. It is for informational and educational purposes only and is not investment advice, research, or a recommendation to buy, sell or hold any security. Nothing here reflects confidential information or the views of any employer. Verify figures against primary sources before relying on them.</p>
      <p class="muted small">© {new Date().getFullYear()} The Analyst Collective · <a href="/about/">About &amp; methodology</a></p>
    </div>
  </footer>
  <script is:inline>
    (function () {
      var root = document.documentElement;
            var btns = document.querySelectorAll('.theme-switch button');
      function current() { return root.dataset.theme === 'dark' ? 'dark' : 'light'; }
      function paint() { var c = current(); btns.forEach(function (b) { b.setAttribute('aria-pressed', String(b.dataset.set === c)); }); }
      btns.forEach(function (b) {
        b.addEventListener('click', function () {
          root.dataset.theme = b.dataset.set;
          try { localStorage.setItem('tac-theme', b.dataset.set); } catch (e) {}
          paint();
        });
      });
      paint();
    })();
  </script>
</body>
</html>
<style>
  .masthead { border-bottom: 1px solid var(--rule); }
  .mast-top { display: flex; justify-content: space-between; gap: 12px; padding-top: 14px; flex-wrap: wrap; }
  .small { font-size: 13px; }
  .mast-top { align-items: center; }
  .mast-right { display: flex; align-items: center; gap: 14px; }
  .theme-switch { display: inline-flex; border: 1px solid var(--ink); border-radius: 999px; padding: 2px; background: var(--card); }
  .theme-switch button { display: inline-flex; align-items: center; gap: 6px; font: 600 12px/1 var(--sans); letter-spacing: .03em; color: var(--ink-2); background: transparent; border: 0; border-radius: 999px; padding: 6px 10px; cursor: pointer; transition: background .2s, color .2s; }
  .theme-switch button svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
  .theme-switch button[data-set="dark"] svg { fill: currentColor; stroke: none; }
  .theme-switch button[aria-pressed="true"] { background: var(--ink); color: var(--paper); }
  .theme-switch button:hover:not([aria-pressed="true"]) { color: var(--claret); }
  @media (max-width: 520px) { .hide-sm { display: none; } }
  .logo { display: block; text-align: center; font-family: var(--serif); font-weight: 700; font-size: clamp(34px, 7vw, 64px); letter-spacing: -.02em; text-decoration: none; margin: 8px 0 0; line-height: 1.05; color: var(--claret); }
  .logo:hover { color: var(--claret); opacity: .85; }
  .tagline { text-align: center; margin: 6px 0 14px; font-size: 13px; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-2); }
  .nav { border-top: 1px solid var(--rule); }
  .nav-inner { display: flex; gap: 4px; overflow-x: auto; scrollbar-width: none; justify-content: center; }
  .nav-inner::-webkit-scrollbar { display: none; }
  .nav a { white-space: nowrap; padding: 10px 12px; font-size: 14px; font-weight: 600; text-decoration: none; border-bottom: 3px solid transparent; }
  .nav a.on { border-bottom-color: var(--claret); }
  @media (max-width: 760px) { .nav-inner { justify-content: flex-start; } }
  main { padding-bottom: 48px; min-height: 50vh; }
  .foot { border-top: 4px solid var(--ink); background: var(--paper-2); padding: 24px 0 32px; }
  .logo-sm { font-family: var(--serif); font-size: 22px; font-weight: 700; margin: 0 0 8px; color: var(--claret); }
  .foot p { max-width: 820px; }
</style>
