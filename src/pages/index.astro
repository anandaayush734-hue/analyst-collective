---
import Base from '../layouts/Base.astro';
import BriefBody from '../components/BriefBody.astro';
import { latest, fmtDate, sectorName } from '../lib';
import deals from '../data/deals.json';
import { getCollection } from 'astro:content';
import ValuationSchool from '../components/ValuationSchool.astro';
const cases = (await getCollection('case-studies')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const recentDeals = [...deals].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 4);
---
<Base>
  {latest ? <BriefBody brief={latest} /> : <p>No brief published yet.</p>}

  <div class="section-title"><h2>Public Deal Tracker</h2><a href="/deals/">All transactions →</a></div>
  <div class="table-scroll">
    <table class="data">
      <thead><tr><th>Date</th><th>Sector</th><th>Type</th><th>Target / Issuer</th><th>Value</th><th>Status</th></tr></thead>
      <tbody>
        {recentDeals.map((d) => (
          <tr>
            <td style="white-space:nowrap">{fmtDate(d.date, { day: '2-digit', month: 'short', year: 'numeric' })}</td>
            <td>{sectorName(d.sector)}</td>
            <td><span class="pill">{d.type}</span></td>
            <td><a href={d.url} target="_blank" rel="noopener">{d.target}</a></td>
            <td>{d.value}</td>
            <td>{d.status}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="section-title"><h2>Case Studies</h2><a href="/case-studies/">All case studies →</a></div>
  <div class="cases">
    {cases.map((c) => (
      <a class="case" href={`/case-studies/${c.id}/`}>
        <p class="kicker">{sectorName(c.data.sector)} · {c.data.dealType}</p>
        <h3>{c.data.title}</h3>
        <p class="muted">{c.data.dek}</p>
      </a>
    ))}
  </div>

  <ValuationSchool compact />

  <div class="section-title"><h2>Meet the Analyst</h2><a href="/meet-the-analyst/">Full profile →</a></div>
  <a class="meet" href="/meet-the-analyst/">
    <img src="/images/ayush-anand.jpg" alt="Ayush Anand" width="120" height="154" loading="lazy" />
    <div>
      <h3>Ayush Anand</h3>
      <p class="muted">A finance graduate who saw that general news buries what matters to an Industrials banker, so he built an automated, AI-assisted pipeline to filter it. This site is his learning project.</p>
      <span class="meet-cta">Read more &amp; download resume →</span>
    </div>
  </a>
</Base>
<style>
  .cases { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; }
  .case { text-decoration: none; display: block; padding-top: 4px; }
  .case h3 { font-size: 21px; }
  .case:hover h3 { color: var(--claret); }
  .case p.muted { font-size: 15px; margin: 0; }
  .meet { display: grid; grid-template-columns: 120px 1fr; gap: 24px; align-items: center; text-decoration: none; max-width: 820px; }
  .meet img { width: 120px; height: auto; display: block; border-top: 3px solid var(--claret); }
  .meet h3 { font-size: 24px; margin-bottom: 4px; }
  .meet p { margin: 0 0 8px; }
  .meet-cta { font-size: 14px; font-weight: 600; color: var(--oxford); }
  .meet:hover h3 { color: var(--claret); }
  @media (max-width: 520px) { .meet { grid-template-columns: 88px 1fr; gap: 14px; } .meet img { width: 88px; } }
</style>
