---
import snapshot from '../data/market-snapshot.json';
interface Props { slug: string; sectorName: string }
const { slug, sectorName } = Astro.props;
const snap: any = snapshot;
const data = snap.sectors?.[slug];
const hasData = !!(data && data.ranges && Object.keys(data.ranges).length);
const sessionLabel = snap.session
  ? new Date(snap.session + 'T00:00:00+05:30').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Asia/Kolkata' })
  : '';
const payload = hasData ? JSON.stringify({ name: data.name, bench: snap.benchmark || 'Nifty 50', ranges: data.ranges }) : '';
const fmt = (v: number | null | undefined) => (v == null ? '–' : `${v > 0 ? '+' : ''}${v.toFixed(2)}%`);
---
<section class="mkt" data-sector-chart>
  <div class="mkt-head">
    <div>
      <p class="kicker">Market performance</p>
      <h2>{hasData ? data.name : sectorName} vs {snap.benchmark || 'Nifty 50'}</h2>
      {hasData && <p class="muted sub">Session close {sessionLabel} · updated after market close (4:00 PM IST)</p>}
    </div>
    {hasData && (
      <div class="ranges" role="group" aria-label="Time range">
        {['1D', '1M', '6M', '1Y'].filter((r) => data.ranges[r]).map((r, i) => (
          <button type="button" data-range={r} aria-pressed={i === 0 ? 'true' : 'false'}>{r}</button>
        ))}
      </div>
    )}
  </div>

  {hasData ? (
    <>
      <div class="stats" aria-live="polite">
        <div><p class="label"><span class="sw sw-sector"></span>{data.name}</p><p class="val" data-stat="sector">–</p></div>
        <div><p class="label"><span class="sw sw-bench"></span>{snap.benchmark || 'Nifty 50'}</p><p class="val" data-stat="bench">–</p></div>
        <div><p class="label">Relative</p><p class="val" data-stat="rel">–</p><p class="rel-note" data-stat="relnote"></p></div>
      </div>
      <div class="plot" data-plot role="img" aria-label={`Line chart of ${data.name} versus ${snap.benchmark || 'Nifty 50'}, percentage change`}></div>
      <div class="tip" data-tip hidden></div>
      <script type="application/json" data-payload set:html={payload} />

      <details class="cons">
        <summary>Today's moves in the {data.source === 'index' ? 'sector' : 'basket'} ({data.constituents.filter((c: any) => c.dayChange != null).length} companies)</summary>
        <div class="table-scroll">
          <table class="data">
            <thead><tr><th>Company</th><th>NSE symbol</th><th style="text-align:right">1D change</th></tr></thead>
            <tbody>
              {data.constituents.filter((c: any) => c.dayChange != null).map((c: any) => (
                <tr><td>{c.name}</td><td class="mono">{c.symbol}</td><td class="mono" style="text-align:right">{c.dayChange > 0 ? '▲' : c.dayChange < 0 ? '▼' : ''} {fmt(c.dayChange)}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
      <p class="foot muted">{data.note} Price data via Yahoo Finance, end of day; for information only, not investment advice.</p>
    </>
  ) : (
    <p class="empty muted">The sector-vs-Nifty chart appears after the next market-close update (weekdays, 4:00 PM IST).</p>
  )}
</section>

<style>
  .mkt { border-top: 4px solid var(--ink); margin-top: 28px; padding-top: 12px; }
  .mkt-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; flex-wrap: wrap; }
  .mkt-head h2 { font-size: 26px; margin: 2px 0 2px; }
  .sub { font-size: 13px; margin: 0; }
  .ranges { display: inline-flex; border: 1px solid var(--ink); border-radius: 2px; }
  .ranges button { font: 600 13px/1 var(--sans); padding: 8px 12px; background: transparent; color: var(--ink); border: 0; border-right: 1px solid var(--rule); cursor: pointer; }
  .ranges button:last-child { border-right: 0; }
  .ranges button[aria-pressed="true"] { background: var(--ink); color: var(--paper); }
  .stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-bottom: 1px solid var(--rule); margin: 14px 0 6px; }
  .stats > div { padding: 8px 14px 10px 0; }
  .label { margin: 0; font-size: 12px; font-weight: 600; letter-spacing: .05em; text-transform: uppercase; color: var(--ink-2); display: flex; align-items: center; gap: 6px; }
  .val { margin: 2px 0 0; font-family: var(--mono); font-size: 24px; font-weight: 700; font-variant-numeric: tabular-nums; }
  .rel-note { margin: 0; font-size: 12px; color: var(--ink-2); }
  .sw { display: inline-block; width: 16px; height: 0; border-top: 2px solid var(--s-sector); }
  .sw-bench { border-top: 2px dashed var(--s-bench); }
  .plot { position: relative; width: 100%; height: 300px; }
  .plot :global(svg) { display: block; width: 100%; height: 100%; overflow: visible; }
  .plot :global(.grid) { stroke: var(--rule); stroke-width: 1; }
  .plot :global(.zero) { stroke: var(--ink-2); stroke-width: 1; stroke-dasharray: 3 3; }
  .plot :global(.axis) { fill: var(--ink-2); font: 11px var(--sans); font-variant-numeric: tabular-nums; }
  .plot :global(.l-sector) { fill: none; stroke: var(--s-sector); stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
  .plot :global(.l-bench) { fill: none; stroke: var(--s-bench); stroke-width: 2; stroke-dasharray: 6 4; stroke-linejoin: round; }
  .plot :global(.end-label) { font: 600 11px var(--sans); fill: var(--ink); }
  .plot :global(.cross) { stroke: var(--ink-2); stroke-width: 1; }
  .plot :global(.dot) { stroke: var(--paper); stroke-width: 2; }
  .tip { position: absolute; pointer-events: none; background: var(--card); border: 1px solid var(--rule); box-shadow: 0 2px 8px rgba(0,0,0,.12); padding: 8px 10px; font-size: 12px; line-height: 1.5; min-width: 150px; z-index: 5; }
  .tip :global(b) { font-family: var(--mono); }
  .tip :global(.sw) { display: inline-block; width: 14px; height: 0; border-top: 2px solid var(--s-sector); vertical-align: middle; }
  .tip :global(.sw-bench) { border-top: 2px dashed var(--s-bench); }
  .mkt { position: relative; }
  .cons { margin-top: 10px; }
  .cons summary { cursor: pointer; font-weight: 600; font-size: 14px; color: var(--oxford); padding: 6px 0; }
  .mono { font-family: var(--mono); font-size: 13px; }
  .foot { font-size: 12px; margin: 8px 0 0; }
  .empty { padding: 16px 0; }
  @media (max-width: 600px) { .val { font-size: 18px; } .plot { height: 240px; } .stats > div { padding-right: 8px; } }
</style>

<script>
  type Pt = [number, number];
  const root = document.querySelector<HTMLElement>('[data-sector-chart]');
  const payloadEl = root?.querySelector('[data-payload]');
  if (root && payloadEl) {
    const P = JSON.parse(payloadEl.textContent || '{}');
    const plot = root.querySelector<HTMLElement>('[data-plot]')!;
    const tip = root.querySelector<HTMLElement>('[data-tip]')!;
    const btns = root.querySelectorAll<HTMLButtonElement>('[data-range]');
    let range = btns[0]?.dataset.range || '1D';
    const pct = (v: number | null | undefined) => (v == null ? '–' : `${v > 0 ? '+' : ''}${v.toFixed(2)}%`);
    const tz = { timeZone: 'Asia/Kolkata' } as const;
    const fmtX = (t: number, r: string) => r === '1D'
      ? new Date(t * 1000).toLocaleTimeString('en-GB', { ...tz, hour: '2-digit', minute: '2-digit' })
      : new Date(t * 1000).toLocaleDateString('en-GB', { ...tz, day: 'numeric', month: 'short', ...(r === '1Y' ? { year: '2-digit' } : {}) });
    const NS = 'http://www.w3.org/2000/svg';
    const el = (tag: string, attrs: Record<string, any>, text?: string) => {
      const e = document.createElementNS(NS, tag);
      for (const k in attrs) e.setAttribute(k, String(attrs[k]));
      if (text != null) e.textContent = text;
      return e;
    };
    const niceStep = (span: number) => { const raw = span / 4; const m = Math.pow(10, Math.floor(Math.log10(raw))); return [1, 2, 2.5, 5, 10].map((k) => k * m).find((s) => s >= raw) || raw; };

    function stats(r: any) {
      const s = r.sectorChange, b = r.niftyChange;
      root!.querySelector('[data-stat="sector"]')!.textContent = pct(s);
      root!.querySelector('[data-stat="bench"]')!.textContent = pct(b);
      const rel = s != null && b != null ? s - b : null;
      root!.querySelector('[data-stat="rel"]')!.textContent = rel == null ? '–' : `${rel > 0 ? '+' : ''}${rel.toFixed(2)} pp`;
      root!.querySelector('[data-stat="relnote"]')!.textContent = rel == null ? '' : rel >= 0 ? `Outperformed ${P.bench}` : `Underperformed ${P.bench}`;
    }

    function draw() {
      const r = P.ranges[range]; if (!r) return;
      stats(r);
      const S: Pt[] = r.sector || [], B: Pt[] = r.nifty || [];
      const W = plot.clientWidth, H = plot.clientHeight;
      const m = { t: 10, r: W < 500 ? 70 : 110, b: 26, l: 44 };
      const all = [...S, ...B];
      const t0 = Math.min(...all.map((p) => p[0])), t1 = Math.max(...all.map((p) => p[0]));
      let y0 = Math.min(0, ...all.map((p) => p[1])), y1 = Math.max(0, ...all.map((p) => p[1]));
      const step = niceStep((y1 - y0) || 1);
      y0 = Math.floor(y0 / step) * step; y1 = Math.ceil(y1 / step) * step;
      const X = (t: number) => m.l + ((t - t0) / ((t1 - t0) || 1)) * (W - m.l - m.r);
      const Y = (v: number) => m.t + (1 - (v - y0) / ((y1 - y0) || 1)) * (H - m.t - m.b);
      const svg = el('svg', { viewBox: `0 0 ${W} ${H}`, 'aria-hidden': 'true' });
      for (let v = y0; v <= y1 + 1e-9; v += step) {
        svg.append(el('line', { x1: m.l, x2: W - m.r, y1: Y(v), y2: Y(v), class: Math.abs(v) < 1e-9 ? 'zero' : 'grid' }));
        svg.append(el('text', { x: m.l - 6, y: Y(v) + 4, 'text-anchor': 'end', class: 'axis' }, `${v > 0 ? '+' : ''}${+v.toFixed(2)}%`));
      }
      const nT = W < 500 ? 3 : 5;
      for (let i = 0; i <= nT; i++) {
        const t = t0 + ((t1 - t0) * i) / nT;
        svg.append(el('text', { x: X(t), y: H - 6, 'text-anchor': i === 0 ? 'start' : i === nT ? 'end' : 'middle', class: 'axis' }, fmtX(t, range)));
      }
      const path = (pts: Pt[]) => pts.map((p, i) => `${i ? 'L' : 'M'}${X(p[0]).toFixed(1)},${Y(p[1]).toFixed(1)}`).join('');
      svg.append(el('path', { d: path(B), class: 'l-bench' }));
      svg.append(el('path', { d: path(S), class: 'l-sector' }));
      // Direct end labels, nudged apart if they collide
      const ends = [
        { p: S[S.length - 1], txt: `${P.name} ${pct(r.sectorChange)}` },
        { p: B[B.length - 1], txt: `${P.bench} ${pct(r.niftyChange)}` },
      ].filter((e) => e.p).map((e) => ({ ...e, y: Y(e.p[1]) }));
      if (ends.length === 2 && Math.abs(ends[0].y - ends[1].y) < 14) {
        const mid = (ends[0].y + ends[1].y) / 2, up = ends[0].y <= ends[1].y ? 0 : 1;
        ends[up].y = mid - 7; ends[1 - up].y = mid + 7;
      }
      const short = W < 500;
      for (const e of ends) svg.append(el('text', { x: X(e.p[0]) + 6, y: e.y + 4, class: 'end-label' }, short ? e.txt.split(' ').pop()! : e.txt));
      // Hover layer
      const cross = el('line', { y1: m.t, y2: H - m.b, class: 'cross', visibility: 'hidden' });
      const dS = el('circle', { r: 4.5, class: 'dot', fill: 'var(--s-sector)', visibility: 'hidden' });
      const dB = el('circle', { r: 4.5, class: 'dot', fill: 'var(--s-bench)', visibility: 'hidden' });
      svg.append(cross, dS, dB);
      const hit = el('rect', { x: m.l, y: m.t, width: Math.max(0, W - m.l - m.r), height: Math.max(0, H - m.t - m.b), fill: 'transparent' });
      svg.append(hit);
      const nearest = (pts: Pt[], t: number) => { let lo = 0, hi = pts.length - 1; while (lo < hi) { const md = (lo + hi) >> 1; if (pts[md][0] < t) lo = md + 1; else hi = md; } const a = pts[Math.max(0, lo - 1)], b = pts[lo]; return !a ? b : Math.abs(a[0] - t) < Math.abs(b[0] - t) ? a : b; };
      const move = (ev: PointerEvent) => {
        const rect = (svg as SVGSVGElement).getBoundingClientRect();
        const x = ((ev.clientX - rect.left) / rect.width) * W;
        const t = t0 + ((x - m.l) / (W - m.l - m.r)) * (t1 - t0);
        const s = nearest(S, t), b = nearest(B, t); if (!s) return;
        const cx = X(s[0]);
        cross.setAttribute('x1', String(cx)); cross.setAttribute('x2', String(cx)); cross.setAttribute('visibility', 'visible');
        dS.setAttribute('cx', String(cx)); dS.setAttribute('cy', String(Y(s[1]))); dS.setAttribute('visibility', 'visible');
        if (b) { dB.setAttribute('cx', String(X(b[0]))); dB.setAttribute('cy', String(Y(b[1]))); dB.setAttribute('visibility', 'visible'); }
        tip.innerHTML = `<div class="muted">${range === '1D' ? fmtX(s[0], '1D') + ' IST' : new Date(s[0] * 1000).toLocaleDateString('en-GB', { ...tz, day: 'numeric', month: 'short', year: 'numeric' })}</div>
          <div><span class="sw"></span> ${P.name}: <b>${pct(s[1])}</b></div>
          ${b ? `<div><span class="sw sw-bench"></span> ${P.bench}: <b>${pct(b[1])}</b></div>` : ''}`;
        tip.hidden = false;
        const host = root!.getBoundingClientRect(), pr = plot.getBoundingClientRect();
        let left = pr.left - host.left + (cx / W) * pr.width + 12;
        if (left + tip.offsetWidth > host.width) left -= tip.offsetWidth + 24;
        tip.style.left = `${Math.max(0, left)}px`;
        tip.style.top = `${pr.top - host.top + 8}px`;
      };
      const leave = () => { tip.hidden = true; [cross, dS, dB].forEach((n) => n.setAttribute('visibility', 'hidden')); };
      hit.addEventListener('pointermove', move as any);
      hit.addEventListener('pointerdown', move as any);
      hit.addEventListener('pointerleave', leave);
      plot.replaceChildren(svg);
    }
    btns.forEach((b) => b.addEventListener('click', () => {
      range = b.dataset.range!;
      btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      draw();
    }));
    let raf = 0;
    window.addEventListener('resize', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(draw); });
    draw();
  }
</script>
