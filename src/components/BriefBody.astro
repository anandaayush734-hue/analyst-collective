---
import Story from './Story.astro';
import KeyNumbers from './KeyNumbers.astro';
import { sectors, type Brief } from '../lib';
interface Props { brief: Brief }
const { brief } = Astro.props;
---
<section class="lead">
  <p class="kicker">The Morning Brief</p>
  <h1>{brief.lead.headline}</h1>
  <p class="dek">{brief.lead.dek}</p>
</section>
<KeyNumbers items={brief.keyNumbers} />
<div class="grid">
  {sectors.map((s) => (
    <section class="col">
      <div class="col-head"><h2><a href={`/sectors/${s.slug}/`}>{s.name}</a></h2></div>
      {(brief.sectors[s.slug] ?? []).map((it) => <Story item={it} />)}
      {(brief.sectors[s.slug] ?? []).length === 0 && <p class="muted">No material updates today.</p>}
    </section>
  ))}
</div>
{brief.regulatory && brief.regulatory.length > 0 && (
  <section class="reg">
    <div class="section-title"><h2>Regulatory &amp; Macro Watch</h2></div>
    <div class="reg-grid">{brief.regulatory.map((it) => <Story item={it} />)}</div>
  </section>
)}
<style>
  .lead { padding: 28px 0 0; max-width: 860px; }
  .lead h1 { font-size: clamp(30px, 4.6vw, 48px); }
  .dek { font-family: var(--serif); font-size: 21px; color: var(--ink-2); margin: 0; }
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0 40px; }
  .col { border-top: 4px solid var(--ink); margin-top: 16px; }
  .col-head h2 { font-size: 24px; margin: 10px 0 0; }
  .col-head a { text-decoration: none; }
  .reg-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 0 40px; }
  @media (max-width: 820px) { .grid { grid-template-columns: 1fr; } }
</style>
