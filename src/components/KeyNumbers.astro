---
interface Props { items: { label: string; value: string; note?: string }[] }
const { items } = Astro.props;
---
<section class="kn" aria-label="Key numbers">
  {items.map((k) => (
    <div class="cell">
      <p class="label">{k.label}</p>
      <p class="val">{k.value}</p>
      {k.note && <p class="note">{k.note}</p>}
    </div>
  ))}
</section>
<style>
  .kn { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); border-top: 1px solid var(--ink); border-bottom: 1px solid var(--ink); margin: 24px 0; }
  .cell { padding: 12px 14px; border-right: 1px solid var(--rule); }
  .cell:last-child { border-right: 0; }
  .label { margin: 0; font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--ink-2); font-weight: 600; }
  .val { margin: 2px 0; font-family: var(--mono); font-size: 24px; font-weight: 700; font-variant-numeric: tabular-nums; }
  .note { margin: 0; font-size: 12px; color: var(--ink-2); }
  @media (max-width: 520px) { .kn { grid-template-columns: 1fr 1fr; } .cell:nth-child(2n) { border-right: 0; } .cell { border-bottom: 1px solid var(--rule); } }
</style>
