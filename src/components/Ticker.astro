---
interface Props { items: { tag: string; text: string }[]; date: string }
const { items, date } = Astro.props;
const loop = [...items, ...items];
---
<div class="tape" role="region" aria-label="Latest headlines">
  <div class="tape-label"><span class="dot" aria-hidden="true"></span>LIVE<span class="tape-date">{date}</span></div>
  <div class="tape-viewport">
    <ul class="tape-track">
      {loop.map((it, i) => (
        <li aria-hidden={i >= items.length ? 'true' : undefined}>
          <span class={`tag tag-${it.tag.toLowerCase().replace('&', '')}`}>{it.tag}</span>{it.text}
        </li>
      ))}
    </ul>
  </div>
</div>
<style>
  .tape { display: flex; align-items: stretch; background: var(--tape-bg); color: var(--tape-ink); font-family: var(--mono); font-size: 13px; border-bottom: 2px solid var(--tape-accent); }
  .tape-label { flex: none; display: flex; align-items: center; gap: 8px; padding: 8px 14px; background: var(--tape-accent); color: #000; font-weight: 700; letter-spacing: .08em; }
  .tape-date { font-weight: 500; opacity: .75; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: #c00; animation: blink 1.4s infinite; }
  .tape-viewport { overflow: hidden; flex: 1; position: relative; mask-image: linear-gradient(90deg, transparent, #000 24px, #000 calc(100% - 24px), transparent); }
  .tape-track { display: flex; gap: 40px; list-style: none; margin: 0; padding: 8px 0; width: max-content; animation: scroll var(--dur, 90s) linear infinite; }
  .tape:hover .tape-track, .tape:focus-within .tape-track { animation-play-state: paused; }
  .tape-track li { white-space: nowrap; display: flex; align-items: center; gap: 8px; }
  .tag { font-size: 11px; font-weight: 700; padding: 1px 6px; border-radius: 2px; background: #333; color: #fff; }
  .tag-reg { background: #c8102e; }
  .tag-ev { background: #1a9e6e; }
  .tag-auto { background: #2f6fd1; }
  .tag-ad { background: #7a5cc7; }
  .tag-ind { background: #b5651d; }
  .tag-macro { background: #555; }
  @keyframes scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @keyframes blink { 50% { opacity: .2; } }
  @media (max-width: 600px) { .tape-date { display: none; } }
  @media (prefers-reduced-motion: reduce) {
    .tape-track { animation: none; overflow-x: auto; }
    .tape-viewport { overflow-x: auto; }
    .dot { animation: none; }
  }
</style>
